mixin modal(options = {}, mods)
  -
    const baseName = 'modal'
    let allMods = ''
    if (typeof mods !== 'undefined' && mods) {
      const modsList = mods.split(',')
      for (const element of modsList) {
        allMods += element.trim()[0] === '-' ? ' ' + baseName + element.trim() : ' ' + element.trim() + '__' + baseName
      }
      allMods = allMods.trim()
    }
    const closeLabel = options.closeLabel || 'Закрыть модальное окно'
    const modalClasses = [allMods].concat(options.classes || [])
    const modalAttributes = Object.assign({}, options.attributes || {}, attributes || {})

  .modal.js-modal.is-visible(id=options.id class=modalClasses hidden)&attributes(modalAttributes)
    .modal__backdrop.js-modal-close
    .modal__body
      +ui-button('', '', 'modal, --secondary-dark, --icon').js-modal-close(type='button')
        +svg()
          include ../../images/icon_cross.svg
      .modal__container
        block
