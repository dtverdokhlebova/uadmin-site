-const partnerLogos =['logo-gridcom-rt.svg', 'logo-lanit.svg', 'logo-rhc.svg', 'logo-gazprom.svg', 'logo-cbr.svg']

mixin banner(type, mods)
  -
    const baseName = 'banner'
    let allMods = ''
    if (typeof mods !== 'undefined' && mods) {
      const modsList = mods.split(',')
      for (const element of modsList) {
        allMods += element.trim()[0] === '-' ? ' ' + baseName + element.trim() : ' ' + element.trim() + '__' + baseName
      }
      allMods = allMods.trim()
    }

  section.section.section--pd0.banner(class=allMods data-header-float-after)&attributes(attributes)
    .inner.banner__inner
      .banner__container
        .banner__scene
          img.banner__landscape(src='../../images/banner/landscape.png' alt='')
          img.banner__landscape-foreground(src='../../images/banner/landscape-foreground.png' alt='')
        .banner__content
          .banner__head
            h1.banner__title U-Admin помогает ИТ-отделу работать
            .banner__description
              | Заявки, оборудование, автоматическая инвентаризация, удалённая поддержка, база знаний, проекты и&nbsp;ИИ&nbsp;—&nbsp;в&nbsp;одной системе. Весь необходимый функционал&nbsp;—&nbsp;в&nbsp;бесплатной версии.
          .banner__actions
            +ui-button('Скачать бесплатно', '#contact', '--py-l, --primary, banner')
            +ui-button('Обсудить проект', '#contact', '--py-l, --secondary, banner')
        .banner__visual
          .banner__desktop-media
            .banner__desktop-screenshot
              if type === 'video'
                video(src='https://videos.ctfassets.net/w8fc6tgspyjz/2GvjDQWqhZYQGDhw6trBmn/dfee9439e56af83c636f38825dd84b23/New_Calendar_mp4.mp4' autoplay muted loop playsinline preload='auto')
              else
                img(src='../../images/banner/desktop-screenshot.png' alt='')
          picture.banner__app-media
            source(media='(max-width: 1619px)' srcset='../../images/banner/app-screenshot-compact.png')
            img.banner__app-screenshot(src='../../images/banner/app-screenshot.png' alt='')
        .banner-partners
          each logo in partnerLogos
            .banner-partners__item
              img(src=`../../images/banner/${logo}` alt='')
      block
