mixin features(items, withoutWrapper = false, mods)
  -
    const baseName = 'features'
    let allMods = ''
    if (typeof mods !== 'undefined' && mods) {
      const modsList = mods.split(',')
      for (const element of modsList) {
        allMods += element.trim()[0] === '-' ? ' ' + baseName + element.trim() : ' ' + element.trim() + '__' + baseName
      }
      allMods = allMods.trim()
    }

  if withoutWrapper
    +features-inner(items)
  else
    .features(class=allMods)&attributes(attributes)
      +features-inner(items)


mixin features-inner(items)
  .swiper.features__slider
    .features__main.swiper-wrapper
      each item in items
        .features__item.swiper-slide
          .features__img
            img(src=item.image alt='')
          .features__content
            if item.number
              +ui-p2(item.number, 'features-count').ui-grey
            +ui-h3(item.title, 'features')
            +ui-text().ui-grey
              if item.text
                +ui-p1(item.text)
              if item.list
                +ui-list(item.list, 1)
              if item.textAfter
                +ui-p1(item.textAfter)
    .features__controls
      +ui-slider-controls().features__controls-inner
