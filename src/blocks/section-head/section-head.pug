mixin section-head(data, mods, type)
  -
    const baseName = 'section-head'
    let allMods = ''
    if (typeof mods !== 'undefined' && mods) {
      const modsList = mods.split(',')
      for (const element of modsList) {
        allMods += element.trim()[0] === '-' ? ' ' + baseName + element.trim() : ' ' + element.trim() + '__' + baseName
      }
      allMods = allMods.trim()
    }

  .section-head(class=allMods)&attributes(attributes)
    if data.title
      +ui-h2(data.title, 'section-head')
    if data.description
      +ui-h5(data.description, 'section-head', 'div')
    block
