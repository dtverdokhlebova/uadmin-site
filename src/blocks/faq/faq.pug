mixin faq(items, mods)
  -
    const baseName = 'faq'
    let allMods = ''
    const faqSchema = {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: items.map((item) => ({
        '@type': 'Question',
        name: item.title,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer
        }
      }))
    }
    if (typeof mods !== 'undefined' && mods) {
      const modsList = mods.split(',')
      for (const element of modsList) {
        allMods += element.trim()[0] === '-' ? ' ' + baseName + element.trim() : ' ' + element.trim() + '__' + baseName
      }
      allMods = allMods.trim()
    }

  .faq(class=allMods)&attributes(attributes)
    .faq__list
      each item in items
        +spoiler(item.title)
          +ui-p1(item.answer)
  script(type='application/ld+json')!= JSON.stringify(faqSchema).replace(/</g, '\\u003c')
