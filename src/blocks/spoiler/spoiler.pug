mixin spoiler(title, mods)
  -
    const baseName = 'spoiler'
    let allMods = ''
    if (typeof mods !== 'undefined' && mods) {
      const modsList = mods.split(',')
      for (const element of modsList) {
        allMods += element.trim()[0] === '-' ? ' ' + baseName + element.trim() : ' ' + element.trim() + '__' + baseName
      }
      allMods = allMods.trim()
    }

  .spoiler(class=allMods)&attributes(attributes)
    .spoiler__trigger
      +ui-p1(title)
      span.spoiler__arrow
    .spoiler__content(hidden)
      block
