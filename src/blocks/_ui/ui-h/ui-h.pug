mixin ui-h2(title, mods, tagName = 'h2')
  -
    const baseName = 'ui-h2'
    let allMods = ''
    if (typeof mods !== 'undefined' && mods) {
      const modsList = mods.split(',')
      for (const element of modsList) {
        const modifier = element.trim()
        allMods += modifier[0] === '-' ? ` ${baseName}${modifier}` : ` ${modifier}__${baseName}`
      }
      allMods = allMods.trim()
    }

  #{tagName}.ui-h2(class=allMods)&attributes(attributes)
    if typeof title !== 'undefined' && title !== null
      !=title
    block

