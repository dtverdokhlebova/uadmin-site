  -
    const modules = [
      ['Запуск<br>из заявки', 'icon_locale_select.svg'],
      ['Web SSH / RDP', 'icon_catalog.svg'],
      ['Связь <br>с устройством', 'icon_sla.svg'],
      ['Ролевая<br>модель', 'icon_priorities.svg'],
      ['Журнал<br>сессий', 'icon_request_templates.svg'],
      ['Работа по <br>филиалам', 'icon_verified.svg'],
      ['История <br>действий', 'icon_scan_unknown.svg'],
      ['Единый<br>контекст', 'icon_reports.svg']
