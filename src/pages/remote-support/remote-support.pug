      {
        number: '4.',
        title: 'Сократите среднее время решения',
        image: '../../images/features/features_remote_support_4.jpg',
        text: 'Меньше уточняющих звонков и переключений между утилитами — больше инцидентов решается в первой линии.'
      }
    ]

  -
    const comparisonData = {
      title: 'Не просто функция. Новый рабочий контур <span class="ui-nowrap">ИТ-службы</span>',
      items: [
        {
          title: 'Без U-Admin',
          modifier: 'disable',
