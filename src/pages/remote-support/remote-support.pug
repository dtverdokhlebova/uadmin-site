  -
    const benefitsData2 = {
      title: 'U-Admin работает как единая система',
      description: 'Эта функция не изолирована. Она использует общий контекст пользователей, оборудования, заявок, площадок, прав доступа и аналитики. Поэтому данные не приходится переносить между несколькими решениями.',
