  -
    const featuresItems = [
      {
        number: '1.',
        title: 'Начинайте сессию из карточки заявки',
        image: '../../images/features/features_remote_support_1.jpg',
        text: 'Не нужно копировать идентификаторы между системами. Инженер выбирает связанное устройство и запускает доступ в контексте инцидента.'
