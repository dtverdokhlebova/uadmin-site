  -
    const audienceData = {
      title: 'Кому подходит',
      items: [
        {
          text: 'Компаниям с филиалами, площадками и централизованной <span class="ui-nowrap">ИТ-службой</span>',
          icon: '../../images/icons/icon_arrow_right_romb.svg'
        },
        {
          text: 'Организациям, которые заменяют дорогой, устаревший, иностранный или самописный Service Desk.',
          icon: '../../images/icons/icon_arrow_right_romb.svg'
        },
        {
          text: 'Командам, которым нужен единый контур заявок, оборудования и удалённой поддержки.',
          icon: '../../images/icons/icon_arrow_right_romb.svg'
        },
        {
          text: 'Заказчикам, для которых стоимость и скорость кастомизации критичны.',
          icon: '../../images/icons/icon_arrow_right_romb.svg'
        }
      ]
    }

  -
    const faqData = [
      {
        title: 'Можно ли подключаться к рабочему месту пользователя прямо из Service Desk?',
        answer: 'Да. В U-ADMIN удалённая поддержка связана с контекстом заявки и ИТ-актива: инженер работает с обращением, видит связанное оборудование и может перейти к доступному сценарию удалённого управления. Это сокращает переключения между Service Desk, учётом оборудования и отдельными инструментами поддержки.'
      },
      {
        title: 'Какие протоколы удалённого доступа поддерживает U-ADMIN?',
        answer: 'В U-ADMIN предусмотрено удалённое управление по Web SSH и RDP. Web SSH позволяет запускать временную SSH-сессию из карточки конфигурационной единицы после проверки прав доступа; доступность RDP зависит от используемого сценария и настроек инфраструктуры.'
      },
      {
        title: 'Можно ли использовать U-ADMIN для удалённой поддержки филиалов и офисов?',
        answer: 'Да. U-ADMIN объединяет заявки, сведения об оборудовании и инструменты удалённого управления в одной системе, поэтому его можно использовать для централизованной поддержки распределённой инфраструктуры, филиалов и удалённых рабочих мест.'
      },
      {
        title: 'Как обеспечивается контроль доступа при удалённом подключении?',
        answer: 'Удалённые действия выполняются с учётом прав пользователя. Для Web SSH предусмотрена проверка прав и мастер-пароля, а секреты по конфигурационным единицам хранятся в зашифрованном виде с аудитом операций доступа.'
      },
      {
        title: 'Можно ли проверить доступность компьютера или сервера перед подключением?',
        answer: 'Да. В U-ADMIN есть Network Check для проверки доступности узла, включая Ping и TCP/22, а также сетевые данные по конфигурационной единице. Это помогает инженеру сначала проверить соединение, а затем переходить к удалённой сессии.'
      },
      {
        title: 'Видит ли инженер информацию об устройстве перед удалённой поддержкой?',
        answer: 'Да. В карточке ИТ-актива доступны модель и характеристики, владелец, статус, файлы, история изменений и связанные обращения. Инженер получает контекст по рабочему месту до начала удалённого подключения.'
      },
      {
        title: 'Можно ли хранить учётные данные для доступа к оборудованию в U-ADMIN?',
        answer: 'Для конфигурационных единиц предусмотрено хранение зашифрованных секретов с созданием, изменением, удалением и контролируемым раскрытием. Действия с доступом к секретам фиксируются в аудите.'
      },
      {
        title: 'Может ли U-ADMIN заменить отдельную программу для удалённой поддержки?',
        answer: 'Для сценариев, которые покрываются Web SSH и RDP, часть задач удалённой поддержки можно выполнять непосредственно в U-ADMIN. Необходимость отдельного инструмента зависит от требований компании к протоколам, функциям сессии и политике информационной безопасности.'
      }
    ]

block header
  +header(true, '--noBg')

block content
  main.main
    +banner-hero(hero)

    +section
      +section-head({ title: comparisonData.title, description: ''}, '--center, --tablet-w-100')
      +comparison(comparisonData.items)

    +section
      +section-head({ title: benefitsData.title, description: benefitsData.description}, '--center')
      +benefits(benefitsData.items)

    +section
      +section-head({ title: 'Как это работает', description: ''}, '--center')
      +box('--section')
        +cards(stepsData)
      +features(featuresItems)

    +section
      +section-head({ title: 'Возможности модуля', description: ''}, '--center')
      +module-features(modules)

    +section
      +section-head({ title: benefitsData2.title, description: benefitsData2.description}, '--center')
      +benefits(benefitsData2.items)

    +section
      +section-head({ title: audienceData.title, description: ''}, '--center')
      +cards(audienceData.items)

    +section
      +section-head({ title: 'Частые вопросы', description: ''}, '--center')
      +faq(faqData)

    +contact(contactData)
