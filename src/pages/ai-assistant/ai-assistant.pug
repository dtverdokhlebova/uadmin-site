extends ../../layouts/layout

block variables
  -const pageTitle = 'AI'
  -const hasHeader = true

  -
    const contactData = {
      title: 'Проверьте U-Admin на реальных сценариях вашей <span class="ui-nowrap">ИТ-службы</span>',
      text: 'Покажем систему на ваших процессах, оценим миграцию и составим план запуска',
      formButtonText: 'Запросить демонстрацию',
    }

  -
    const hero = {
      title: 'Все обращения — в единой очереди. Ни&nbsp;одна заявка не&nbsp;потеряется',
      description: 'U‑ADMIN помогает анализировать контекст инцидента, выявлять возможные причины и рекомендовать следующие шаги. Автоматизация снимает рутину, а аналитика показывает, где ИТ теряет время и ресурсы.',
      breadcrumbs: [
        {
          title: 'Возможности',
          href: '#'
        }
      ],
      actions: [
        {
          title: 'Запросить демонстрацию',
          href: '#contact',
          mods: '--primary, --py-l'
        },
        {
          title: 'Попробовать на своих данных',
          href: '#contact',
          mods: '--secondary, --py-l'
        }
      ],
      image: '../../images/banner-hero/banner_hero_ai_assistant.jpg',
      imageAlt: 'Интерфейс AI-помощника'
    }

  -
    const stepsData = [
      {
        title: 'Данные',
        text: 'Заявка, актив, события, история',
        img: '../../images/cards/cards_tickets_step_1.png',
      },
      {
        title: 'Анализ',
        text: 'Сопоставление сигналов',
        img: '../../images/cards/cards_tickets_step_2.png',
      },
      {
        title: 'Рекомендации',
        text: 'Проверки и следующий шаг',
        img: '../../images/cards/cards_tickets_step_3.png',
      },
      {
        title: 'Обучение',
        text: 'Подтверждённое решение в знания',
        img: '../../images/cards/cards_tickets_step_4.png',
      }
    ]

  -
    const featuresItems = [
      {
        number: '1.',
        title: 'Анализируйте причину прямо в карточке',
        image: '../../images/features/features_ai_assistant_1.jpg',
        text: 'По команде инженер получает краткую сводку, возможные причины и рекомендуемую последовательность проверки.'
      },
      {
        number: '2.',
        title: 'Выявляйте признаки деградации',
        image: '../../images/features/features_ai_assistant_2.jpg',
        text: 'Высокая загрузка диска, рост использования памяти, остановленные службы и другие сигналы можно связать с инцидентом и активом.'
      },
      {
        number: '3.',
        title: 'Автоматизируйте типовые операции',
        image: '../../images/features/features_ai_assistant_3.jpg',
        text: 'Правила маршрутизации, уведомления, эскалации и шаблонные действия уменьшают число ручных шагов.'
      },
      {
        number: '4.',
        title: 'Накапливайте знания команды',
        image: '../../images/features/features_ai_assistant_4.jpg',
        text: 'Подтверждённые решения превращаются в повторяемые сценарии и материалы базы знаний.'
      }
    ]

  -
    const comparisonData = {
      title: 'Не просто функция. Новый рабочий контур <span class="ui-nowrap">ИТ-службы</span>',
      items: [
        {
          title: 'Без U-Admin',
          modifier: 'disable',
          icon: '../../images/comparisons/comparisons_tickets_without.png',
          items: [
            'Обращения приходят в почту, мессенджеры и по телефону;',
            'Пользователи не понимают, кто и когда решит проблему;',
            'Руководителю сложно контролировать загрузку и соблюдение SLA;',
            'История решений теряется вместе с перепиской.'
          ]
        },
        {
          title: 'С U-Admin',
          modifier: 'enable',
          icon: '../../images/comparisons/comparisons_tickets_with.png',
          items: [
            'Больше контекста для инженера;',
            'Повторяемая диагностика;',
            'Данные для управленческих решений;',
            'Единая история и измеримый результат.'
          ]
        }
      ]
    }

  -
    const benefitsData = {
      title: 'Три причины выбрать <span class="ui-nowrap">U-Admin</span>',
      items: [
        {
          title: 'Больше контекста для инженера',
          text: 'ИИ сопоставляет заявку, актив, состояние устройства и историю событий.',
          icon: '../../images/benefits/benefits_tickets_reason_1.png',
        },
        {
          title: 'Повторяемая диагностика',
          text: 'Подсказки помогают первой линии работать по единым сценариям.',
          icon: '../../images/benefits/benefits_tickets_reason_2.png',
        },
        {
          title: 'Данные для управленческих решений',
          text: 'Тренды, повторные инциденты и проблемные активы становятся видимыми.',
          icon: '../../images/benefits/benefits_tickets_reason_3.png',
        }
      ]
    }

  -
    const benefitsData2 = {
      title: 'U-Admin работает как единая система',
      description: 'Эта функция не изолирована. Она использует общий контекст пользователей, оборудования, заявок, площадок, прав доступа и аналитики. Поэтому данные не приходится переносить между несколькими решениями.',
      items: [
        {
          title: 'Единые данные',
          text: 'Одна модель пользователей, активов, заявок и подразделений.',
          icon: '../../images/benefits/benefits_tickets_system_1.png',
        },
        {
          title: 'Единые процессы',
          text: 'Маршрутизация, права, уведомления, SLA и аудит.',
          icon: '../../images/benefits/benefits_tickets_system_2.png',
        },
        {
          title: 'Доступная адаптация',
          text: 'Настраиваем систему под процессы компании без высокой стоимости доработок.',
          icon: '../../images/benefits/benefits_tickets_system_3.png',
        }
      ]
    }

  -
    const modules = [
      ['Рекомендации', 'icon_sla.svg'],
      ['Поиск<br>аномалий', 'icon_priorities.svg'],
      ['Автомаршрутизация', 'icon_request_templates.svg'],
      ['Правила и<br>триггеры', 'icon_verified.svg'],
      ['Повторные<br>инциденты', 'icon_scan_unknown.svg'],
      ['Аналитика<br>тенденций', 'icon_reports.svg']
    ]

  -
    const audienceData = {
      title: 'Кому подходит',
      items: [
        {
          text: 'Компаниям с филиалами, площадками и централизованной <span class="ui-nowrap">ИТ-службой</span>',
          icon: '../../images/icons/icon_arrow_right_romb.svg'
        },
        {
          text: 'Организациям, которые заменяют дорогой, устаревший, иностранный или самописный Service Desk.',
          icon: '../../images/icons/icon_arrow_right_romb.svg'
        },
        {
          text: 'Командам, которым нужен единый контур заявок, оборудования и удалённой поддержки.',
          icon: '../../images/icons/icon_arrow_right_romb.svg'
        },
        {
          text: 'Заказчикам, для которых стоимость и скорость кастомизации критичны.',
          icon: '../../images/icons/icon_arrow_right_romb.svg'
        }
      ]
    }

  -
    const faqData = [
      {
        title: 'Что умеет искусственный интеллект в Service Desk U-ADMIN?',
        answer: 'ИИ в U-ADMIN помогает автоматизировать обработку обращений: анализирует текст заявки, предлагает классификацию, ищет подходящие решения, подсказывает инженеру следующие действия и помогает готовить ответы. Также ИИ используется в аналитике, базе знаний и работе с CMDB.'
      },
      {
        title: 'Может ли ИИ автоматически классифицировать входящие заявки?',
        answer: 'Да. При создании обращения ИИ может предложить тип, категорию, приоритет и назначение, а также заполнить тему и другие параметры на основе описания пользователя. Это сокращает ручную работу первой линии поддержки.'
      },
      {
        title: 'Может ли ИИ уточнить заявку, если пользователь описал проблему слишком кратко?',
        answer: 'Да. При включённой настройке ИИ может задавать уточняющие вопросы, если исходного описания недостаточно для корректной классификации обращения. Это помогает получать более полные данные ещё на этапе регистрации заявки.'
      },
      {
        title: 'Может ли ИИ подсказать инженеру решение по обращению?',
        answer: 'Да. В карточке обращения ИИ может предложить возможные причины, проверки и дополнительные вопросы, обратиться к базе знаний и сформировать черновик ответа пользователю. Инженер принимает решение самостоятельно и использует подсказки как рабочий инструмент.'
      },
      {
        title: 'Находит ли ИИ похожие обращения и повторяющиеся инциденты?',
        answer: 'Да. Система ищет похожие открытые и закрытые обращения, а ИИ может ранжировать наиболее полезные результаты. Также он помогает выявлять кандидатов в проблему или массовый инцидент на основе повторяющихся обращений.'
      },
      {
        title: 'Может ли ИИ помочь руководителю Service Desk с аналитикой?',
        answer: 'Да. ИИ может сформировать краткий план того, что требует внимания сейчас, и управленческий отчёт по нагрузке, просрочкам и повторяющимся проблемам. Это дополняет стандартные отчёты и дашборды Service Desk.'
      },
      {
        title: 'Может ли ИИ создавать статьи базы знаний из решённых заявок?',
        answer: 'Да. Решение из закрытой заявки можно преобразовать в статью базы знаний: ИИ формирует заголовок, краткое описание, основной текст и теги. Так накопленный опыт поддержки быстрее превращается в повторно используемые инструкции.'
      },
      {
        title: 'Можно ли контролировать использование AI и подключить Yandex AI?',
        answer: 'В U-ADMIN предусмотрен отдельный провайдер Yandex AI с настройкой через folder_id и API key. Система также ведёт учёт расхода токенов по цели, провайдеру, модели, результату выполнения и объёму использования.'
      }
    ]

block header
  +header(true, '--noBg')

block content
  main.main
    +banner-hero(hero)

    +section
      +section-head(comparisonData.title, '', '--center, --tablet-w-100')
      +comparison(comparisonData.items)

    +section
      +section-head(benefitsData.title, benefitsData.description, '--center')
      +benefits(benefitsData.items)

    +section
      +section-head('Как это работает', '', '--center')
      +box('--section')
        +cards(stepsData)
      +features(featuresItems)

    +section
      +section-head('Возможности модуля', '', '--center')
      +module-features(modules)

    +section
      +section-head(benefitsData2.title, benefitsData2.description, '--center')
      +benefits(benefitsData2.items)

    +section
      +section-head(audienceData.title, '', '--center')
      +cards(audienceData.items)

    +section
      +section-head('Частые вопросы', '', '--center')
      +faq(faqData)

    +contact(contactData)
