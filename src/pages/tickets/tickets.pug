block header
  +header(true, '--noBg')

block content
  main.main
    +banner-hero(hero)

    +section
      +section-head(comparisonData.title, '', '--center, --tablet-w-100')
      +comparison(comparisonData.items)

    +section
      +section-head(benefitsData.title, benefitsData.description, '--center')
      +benefits(benefitsData.items)

    +section
      +section-head('Как это работает', '', '--center')
      +box('--section')
        +cards(stepsData)
      +features(featuresItems)

    +section
      +section-head('Возможности модуля', '', '--center')
      +module-features(modules)

    +section
      +section-head(benefitsData2.title, benefitsData2.description, '--center')
      +benefits(benefitsData2.items)

    +section
      +section-head(audienceData.title, '', '--center')
      +cards(audienceData.items)

    +section
      +section-head('Частые вопросы', '', '--center')
      +faq(faqData)

    +contact(contactData)
